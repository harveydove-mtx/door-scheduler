# Copy to .env.production.local (or set in CI) with the V2 Firebase project's web app config:
# Firebase console -> Project settings -> Your apps -> Web app -> SDK setup and configuration.
# These values are not secret (they identify the project; access is controlled by sign-in
# and the Data Connect @auth rules), but keep them out of the code.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
